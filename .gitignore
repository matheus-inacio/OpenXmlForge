## Ignore Visual Studio temporary files, build results, and
## files generated by popular Visual Studio add-ons.

# User-specific files
*.rsuser
*.suo
*.user
*.userosscache
*.sln.docstates
*.DotSettings.user

# User-specific files (MonoDevelop/Xamarin Studio)
*.userprefs

# Mono auto generated files
mono_crash.*

# Build results
[Dd]ebug/
[Dd]ebugPublic/
[Rr]elease/
[Rr]eleases/
x64/
x86/
[Ww][Ii][Nn]32/
[Aa][Rr][Mm]/
[Aa][Rr][Mm]64/
bld/
[Bb]in/
[Oo]bj/
[Ll]og/
[Ll]ogs/
[Aa]rtifacts/

# Visual Studio / VS Code cache/options directory
.vs/
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# JetBrains Rider
.idea/
*.sln.iml

# Visual Studio Test Results
[Tt]est[Rr]esult*/
[Bb]uild[Ll]og.*

# MSTest / xUnit / Coverlet / BenchmarkDotNet
*.VisualState.xml
TestResult.xml
nunit-*.xml
coverage*.json
coverage*.xml
coverage*.info
BenchmarkDotNet.Artifacts/

# .NET Core / Modern .NET
project.lock.json
project.fragment.lock.json
artifacts/
launchSettings.json

# NuGet Packages
*.nupkg
*.snupkg
**/[Pp]ackages/*
!**/[Pp]ackages/build/
*.nuget.props
*.nuget.targets

# Microsoft Azure Build Output
csx/
*.build.csdef

# Publish & Profiling
PublishScripts/
*.Publish.xml
*.pubxml
*.publishproj
*.psess
*.vsp
*.vspx
*.sap
*.etrace

# Others
~$*
*~
.DS_Store
Thumbs.db
